{
    "name": "ai-decision-flow",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "dev:inngest": "inngest-cli dev -u http://localhost:3000/api/inngest --no-discovery",
        "dev:all": "concurrently -n next,inngest -c cyan,magenta \"npm:dev\" \"npm:dev:inngest\"",
