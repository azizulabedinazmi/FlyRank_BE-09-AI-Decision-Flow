        "@xyflow/react": "^13.0.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "inngest": "^4.27.0",
        "lucide-react": "^1.82.0",
        "next": "16.4.6",
        "next-themes": "^0.4.6",
        "openai": "^7.65.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "shadcn": "^4.23.1",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "^24.19.4",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "concurrently": "^10.0.7",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "inngest-cli": "^1.53.0",
        "playwright": "^1.65.1",
        "tailwindcss": "4.3.3",
        "typescript": "^5",
        "vitest": "^5.1.2"
    },
    "allowScripts": {
        "inngest-cli@1.53.0": true
    }
