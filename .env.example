# Copy to .env.local and adjust:   cp .env.example .env.local
# The model behind every decision node: any OpenAI-compatible server. Default: local Ollama (free, no key).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
# Hosted instead (OpenRouter free tier, needs your own key):
#   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_API_KEY=<your key>   LLM_MODEL=openrouter/free
LLM_TIMEOUT_MS=20000

# Talk to the local Inngest dev server (npm run dev:inngest) instead of Inngest Cloud
INNGEST_DEV=1
